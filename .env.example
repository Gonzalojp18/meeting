# Variables de Entorno - Meeting Resto Bar

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here
AUTH_SECRET=your_auth_secret_here

# MongoDB
MONGODB_URI=mongodb://localhost:27017/meeting-restobar

# Mercado Pago
MP_ACCESS_TOKEN=your_mercadopago_token
MP_PUBLIC_KEY=your_mp_public_key

# Cloudinary (opcional)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SuperAdmin Security (CRÍTICO)
# Lista de emails autorizados como superadmin (separados por coma)
# IMPORTANTE: Estos emails tienen acceso TOTAL al sistema
SUPERADMIN_EMAILS=pgonzalojose@gmail.com

# API URI
API_URI=http://localhost:3000
